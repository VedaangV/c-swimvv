@inbook{Kazerooni2019,
author = {Kazerooni, Maryam and Overbye, Thomas J.},
publisher = {American Geophysical Union (AGU)},
isbn = {9781119434412},
title = {Mitigating Power System Response to GICs in Known Networks},
booktitle = {Geomagnetically Induced Currents from the Sun to the Power Grid},
chapter = {13},
pages = {219-232},
doi = {https://doi.org/10.1002/9781119434412.ch13},
url = {https://agupubs.onlinelibrary.wiley.com/doi/abs/10.1002/9781119434412.ch13},
eprint = {https://agupubs.onlinelibrary.wiley.com/doi/pdf/10.1002/9781119434412.ch13},
year = {2019},
keywords = {blocking devices, eliability-based optimal power flow, geomagnetic disturbance response procedures, geomagnetic induced currents, mitigation techniques, power flow solution, power system, transmission line switching, transmission network},
abstract = {Summary This chapter focuses on mitigating the geomagnetic disturbances (GMDs) negative impacts through corrective control actions. Generation redispatch, transmission line switching, and transformer blocking device placement are recognized as three effective mitigation techniques. A generic reliability-based optimization problem is designed to obtain the power system optimal operation during GMDs. The coupling between the ac power flow solution and the geomagnetically induced current (GIC) flows is modeled and heuristic strategies are designed to maintain the system security measures in terms of both GICs and ac power flow. Moreover, the computational complexity of the algorithms are analyzed for large-system implementations.}
}
